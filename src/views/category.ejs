<%- include('partials/header') %>
    <main>
        <h2><%= categoryDetails.name %></h2>
        <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a></p>

        <h3>Projects in this Category</h3>
        <ul>
            <% projects.forEach((project) => { %>
                <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
    </main>

<%- include('partials/footer') %>
